#!/usr/bin/env bash
#
# mcctl — 마인크래프트 서버 관리 명령 모음
#
#   mcctl start|stop|restart|status|console|log|backup|cmd|players|ip|update
#
set -euo pipefail

MC_USER="minecraft"
SERVER_DIR="/opt/minecraft/server"
BACKUP_DIR="/opt/minecraft/backups"
TMUX="tmux -L minecraft"

c_ok()   { printf '\033[1;32m%s\033[0m\n' "$*"; }
c_warn() { printf '\033[1;33m%s\033[0m\n' "$*"; }
c_err()  { printf '\033[1;31m%s\033[0m\n' "$*" >&2; }

need_root() { [[ $EUID -eq 0 ]] || { c_err "sudo가 필요합니다:  sudo mcctl $*"; exit 1; }; }
as_mc() { sudo -u "$MC_USER" "$@"; }

running() { as_mc $TMUX has-session -t mc 2>/dev/null; }

usage() {
  cat <<'EOF'
사용법: sudo mcctl <명령>

  start      서버 시작
  stop       서버 정지 (월드 저장 후 안전하게 종료)
  restart    재시작
  status     실행 상태 / 메모리 / 가동 시간
  console    서버 콘솔 접속  ※ 빠져나올 때는 Ctrl+B 를 누른 뒤 D
  log        최근 로그 실시간 보기 (Ctrl+C 로 종료)
  cmd "..."  콘솔 명령 한 줄 전송   예) sudo mcctl cmd "op 닉네임"
  players    접속자 목록
  backup     지금 즉시 백업
  ip         친구에게 알려줄 접속 주소
  update     서버 팩 업데이트 안내
EOF
}

case "${1:-}" in

  start)
    need_root start
    running && { c_warn "이미 실행 중입니다."; exit 0; }
    systemctl start minecraft
    c_ok "시작했습니다. 월드 로딩에 수 분 걸립니다."
    echo "진행 상황:  sudo mcctl log"
    ;;

  stop)
    need_root stop
    running || { c_warn "실행 중이 아닙니다."; exit 0; }
    echo "월드를 저장하고 종료합니다. 최대 1분 정도 걸립니다..."
    systemctl stop minecraft
    c_ok "정지했습니다."
    ;;

  restart)
    need_root restart
    systemctl stop minecraft 2>/dev/null || true
    sleep 3
    systemctl start minecraft
    c_ok "재시작했습니다."
    ;;

  status)
    need_root status
    if running; then
      c_ok "● 실행 중"
      PID="$(pgrep -u "$MC_USER" -f 'java.*forge|java.*minecraft_server' | head -1 || true)"
      if [[ -n "$PID" ]]; then
        echo "  PID       : $PID"
        echo "  메모리    : $(ps -o rss= -p "$PID" | awk '{printf "%.1f GB", $1/1048576}')"
        echo "  가동 시간 : $(ps -o etime= -p "$PID" | tr -d ' ')"
      fi
    else
      c_warn "○ 정지 상태"
    fi
    echo "  시스템    : RAM $(free -g | awk '/^Mem:/ {print $3"/"$2" GB"}'), 부하 $(cut -d' ' -f1-3 /proc/loadavg)"
    echo "  디스크    : $(df -h "$SERVER_DIR" | awk 'NR==2 {print $3"/"$2" ("$5" 사용)"}')"
    echo "  백업      : $(ls -1 "$BACKUP_DIR"/world-*.tar.gz 2>/dev/null | wc -l)개, 최근 $(ls -1t "$BACKUP_DIR"/world-*.tar.gz 2>/dev/null | head -1 | xargs -r basename || echo 없음)"
    ;;

  console)
    need_root console
    running || { c_err "서버가 실행 중이 아닙니다."; exit 1; }
    c_warn "빠져나올 때는 Ctrl+B 를 누른 뒤 D 를 누르세요. (Ctrl+C 는 서버를 죽입니다)"
    sleep 2
    as_mc $TMUX attach -t mc
    ;;

  log)
    LOG="$SERVER_DIR/logs/latest.log"
    [[ -f "$LOG" ]] || { c_err "로그 파일이 없습니다: $LOG"; exit 1; }
    tail -f -n 60 "$LOG"
    ;;

  cmd)
    need_root cmd
    shift
    [[ $# -gt 0 ]] || { c_err '명령을 적어주세요.  예) sudo mcctl cmd "op 닉네임"'; exit 1; }
    running || { c_err "서버가 실행 중이 아닙니다."; exit 1; }
    as_mc $TMUX send-keys -t mc "$*" Enter
    c_ok "전송: $*"
    echo "결과는  sudo mcctl log  에서 확인하세요."
    ;;

  players)
    need_root players
    running || { c_err "서버가 실행 중이 아닙니다."; exit 1; }
    as_mc $TMUX send-keys -t mc "list" Enter
    sleep 1
    grep -a 'players online' "$SERVER_DIR/logs/latest.log" | tail -1 || echo "정보 없음"
    ;;

  backup)
    need_root backup
    as_mc /opt/minecraft/backup.sh
    ;;

  ip)
    IP="$(curl -s --max-time 5 https://ifconfig.me || echo '확인 실패')"
    PORT="$(grep -oP '^server-port=\K.*' "$SERVER_DIR/server.properties" 2>/dev/null || echo 25565)"
    echo
    c_ok "친구에게 알려줄 주소:  ${IP}:${PORT}"
    echo
    echo "  마크에서: 멀티플레이 → 서버 추가 → 서버 주소에 위 주소 입력"
    echo "  ※ 접속이 안 되면 OCI 콘솔의 '보안 목록' 인그레스 규칙을 확인하세요."
    ;;

  update)
    cat <<EOF

서버 팩 업데이트 순서:

  1. sudo mcctl backup                     # 먼저 백업
  2. sudo mcctl stop
  3. 새 SERVER-PACK zip 을 /opt/minecraft/downloads 에 올린다
  4. sudo bash 02-install-modpack.sh       # 월드는 유지되고 모드만 교체됨
  5. sudo mcctl start

주의: 모드팩 메이저 버전(예: 3.x → 4.x)이 바뀌면 기존 월드가 호환되지 않을 수
있습니다. 업데이트 전에 모드팩 배포처의 변경 내역을 꼭 확인하세요.
그리고 서버와 클라이언트(CurseForge 런처)의 팩 버전은 반드시 같아야 합니다.

EOF
    ;;

  ""|-h|--help|help) usage ;;
  *) c_err "알 수 없는 명령: $1"; echo; usage; exit 1 ;;
esac
